# ==========================================
# INSTITUTIONAL TRADING BOT - CONFIGURATION
# Copy this file to .env and fill your values
# ==========================================

# Database (Railway / Supabase recommended)
SUPABASE_DB_URL=postgresql://user:pass@host:5432/dbname

# Or local SQLite (fallback)
SQLITE_DB_PATH=trading_platform.db

# Encryption key path
SECRET_KEY_PATH=secret.key

# Trading mode
TRADING_MODE=DEMO

# Optional: Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: EVM wallet for DeFi execution
EVM_PRIVATE_KEY=0xYourPrivateKeyHere

# Railway specific (auto-injected)
PORT=8080

# Logging
LOG_LEVEL=INFO