# ==========================================
# INSTITUTIONAL TRADING BOT - CONFIGURATION
# Copy this file to .env and fill your values
# ==========================================

# Database (Railway / Supabase recommended)
SUPABASE_DB_URL=postgresql://user:pass@host:5432/dbname

# Or local SQLite (fallback)
SQLITE_DB_PATH=trading_platform.db

# Encryption key path
SECRET_KEY_PATH=secret.key
# Preferred in production: FERNET_KEY=<64-char urlsafe base64 key> (generated via
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")

# Trading mode
TRADING_MODE=DEMO

# Optional: Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Chat ID for push notifications (get it from @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: EVM wallet for DeFi execution
EVM_PRIVATE_KEY=0xYourPrivateKeyHere

# ==========================================
# OPERATOR AUTHENTICATION (roadmap #4)
# Auth is enforced on all state-changing endpoints when AUTH_ENABLED=true
# OR automatically whenever the platform runs in REAL mode.
# ==========================================
AUTH_ENABLED=false
ADMIN_USER=admin
# STRONGLY change this password in production:
ADMIN_PASSWORD=ChangeMe!Institutionnel2026
# Optional TOTP second factor: base32 secret from e.g. Google Authenticator
ADMIN_TOTP_SECRET=
# JWT signing secret (change in production!). If left empty with AUTH_ENABLED=true,
# a strong key is auto-generated, encrypted and stored in the DB on first boot.
JWT_SECRET_KEY=

# Optional: CryptoCompare news API key (removes 401s on the news feed)
CRYPTOCOMPARE_API_KEY=

# Railway specific (auto-injected)
PORT=8080

# Logging
LOG_LEVEL=INFO

# ==========================================
# ADDITIONAL INSTITUTIONAL CONTROLS (audit remediation)
# ==========================================
# Arbitrage execution mode: 'signal_only' (safe default) or 'auto'
ARBITRAGE_EXECUTION=signal_only
# Shared secret for TradingView / external webhooks (POST /api/v1/webhook/trade)
WEBHOOK_SECRET=
# Comma-separated origins allowed for CORS (empty = same-origin only)
ALLOWED_ORIGINS=
# Path to config.yaml (default: ./config.yaml)
CONFIG_PATH=config.yaml

# LLM narrative / assistant (OpenRouter - OpenAI-compatible). NEVER commit the key.
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini

# ==========================================
# DONNÉES 100% RÉELLES (faille 1 corrigée)
# ==========================================
# Fichier du calendrier macro RÉEL daté en UTC (à maintenir à jour).
# Si absent/vide -> UNAVAILABLE : AUCUNE réduction de risque simulée.
MACRO_CALENDAR_FILE=data/macro_events.json
# Clé optionnelle Finnhub (gratuite) : calendrier économique réel en complément.
FINNHUB_API_KEY=

# ==========================================
# MACHINE À ÉTATS RISQUE (LOT 2, PDF Faille 3)
# ==========================================
# Action sur choc d'actualité systémique : 'reduce' (réduire) ou 'halt' (arrêt)
NEWS_SHOCK_ACTION=reduce
# Durée du HALT (minutes) quand NEWS_SHOCK_ACTION=halt
NEWS_SHOCK_HALT_MINUTES=15
